# OpenAI — required for Empath (Realtime API) and Theatre performer
OPENAI_API_KEY=sk-...

# Anthropic — required for Theatre director and Companion cognition
ANTHROPIC_API_KEY=sk-ant-...

# Picoh serial port. Leave blank to auto-detect.
# macOS examples: /dev/tty.usbmodem21401
# Linux examples: /dev/ttyACM0
# Windows examples: COM3
PICOH_PORT=

# Set to 1 to run all apps without hardware (uses MockPicoh that prints actions).
PICOH_MOCK=0

# Realtime model + voice
PICOH_REALTIME_MODEL=gpt-realtime
PICOH_REALTIME_VOICE=cedar

# Camera index for vision
PICOH_CAMERA_INDEX=0
